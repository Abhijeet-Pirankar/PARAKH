# PARAKH Environment Configuration Template
# Copy this file to .env for local development with docker-compose or environment setups.
# NEVER commit the actual .env file or real secrets to version control.

# JWT Secret for backend authentication (minimum 256 bits / 32 bytes required for HMAC-SHA256)
JWT_SECRET=your_jwt_secret_here_must_be_at_least_32_characters_long

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/recruitshield?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=recruitshield_user
SPRING_DATASOURCE_PASSWORD=recruitshield_password

# Python AI/ML Service Configuration
AI_SERVICE_URL=http://localhost:8000
