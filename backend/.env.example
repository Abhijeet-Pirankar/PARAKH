# PARAKH Backend Local Environment Configuration Template
# Copy this file to .env (which is git-ignored) or set these variables in your local environment.
# NEVER commit real secrets to version control.

# JWT Secret for backend authentication (minimum 256 bits / 32 bytes required for HMAC-SHA256)
JWT_SECRET=your_jwt_secret_here_must_be_at_least_32_characters_long

# Database Configuration (supports local MySQL defaults if omitted)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/recruitshield?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=recruitshield_user
# SPRING_DATASOURCE_PASSWORD=recruitshield_password

# Python AI/ML Service Configuration
# AI_SERVICE_URL=http://localhost:8000

# Rate Limiting Configuration (requests per minute / hour per client IP)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=30
# RATE_LIMIT_PER_HOUR=120
# RATE_LIMIT_TRUSTED_PROXIES=
# RATE_LIMIT_AUTH_LOGIN_PER_MINUTE=10
# RATE_LIMIT_AUTH_REGISTER_PER_MINUTE=5
